# Force LF line endings everywhere (prevents CRLF chaos on Windows)
* text=auto eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.mp3 binary
*.ogg binary
*.wav binary
*.so binary
*.pvr binary
*.POD binary
*.TRP binary
*.xz binary
*.gz binary
*.zip binary
*.7z binary
*.tar binary
*.deb binary
*.rpm binary
*.AppImage binary

# Windows scripts and the end-user quick start keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
tools/windows/README.txt text eol=crlf

# More binary formats used by the Windows port
*.ico binary
*.syso binary
*.exe binary
*.dll binary
